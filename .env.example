# Copie este arquivo para ".env" e preencha com os seus dados.
# NUNCA envie o arquivo .env para o GitHub.

# URL do banco MySQL. Formato:
# mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Exemplo com MySQL local (XAMPP/WAMP/MySQL instalado):
# DATABASE_URL="mysql://root:@localhost:3306/api_tarefas"
#
# Exemplo com Clever Cloud (copie a "Connection URI" do painel e acrescente ?connection_limit=2):
# DATABASE_URL="mysql://uXXXX:SENHA@bXXXX-mysql.services.clever-cloud.com:3306/bXXXX?connection_limit=2"
DATABASE_URL="mysql://root:@localhost:3306/api_tarefas"

# Porta local da API (no Render não precisa: ele define sozinho)
PORT=3000

# Origens liberadas no CORS ("*" = qualquer site). Várias: separe por vírgula.
CORS_ORIGIN="*"
